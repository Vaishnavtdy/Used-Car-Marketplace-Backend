NODE_ENV=development
PORT=7700

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/used_car_marketplace"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Where uploaded car images are stored (relative to the backend folder or absolute)
UPLOAD_DIR=uploads

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the app (0 = none)
TRUST_PROXY=0

# Only read by `npm run seed:admin`
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
