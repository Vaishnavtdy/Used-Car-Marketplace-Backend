generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  DEALER
  ADMIN
  SUPER_ADMIN
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  LPG
  ELECTRIC
  HYBRID
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum BodyType {
  SEDAN
  SUV
  HATCHBACK
  COUPE
  WAGON
}

enum FeatureCategory {
  SAFETY
  COMFORT
  INTERIOR
  EXTERIOR
  TECHNOLOGY
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  EXPIRED
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         UserRole @default(USER)

  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  passwordChangedAt   DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  cars          Car[]
  favorites     Favorite[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id           Int       @id @default(autoincrement())
  userId       Int
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById Int?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// Master list of car makes. Names are unique case-insensitively (see the Brand_name_lower_key index
// in the brand_master migration, which Prisma cannot express).
model Brand {
  id   Int    @id @default(autoincrement())
  name String

  cars      Car[]
  homeBrand HomeBrand?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Car {
  id       Int @id @default(autoincrement())
  sellerId Int
  brandId  Int

  title       String
  description String?

  model   String
  variant String?
  year    Int

  price        Decimal      @db.Decimal(12, 2)
  mileage      Int
  fuelType     FuelType
  transmission Transmission

  color            String?
  ownership        Int?
  registrationCity String?

  // Optional detail shown on the listing page; the body type also drives a filter.
  bodyType         BodyType?
  engine           String?   @db.VarChar(100)
  power            String?   @db.VarChar(100)
  registrationYear Int?

  // Hand-picked for the home page's Featured section
  isFeatured Boolean @default(false)

  status      ListingStatus @default(DRAFT)
  publishedAt DateTime?

  seller    User         @relation(fields: [sellerId], references: [id])
  brand     Brand        @relation(fields: [brandId], references: [id])
  images    CarImage[]
  features  CarFeature[]
  favorites Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([status, isFeatured])
  @@index([sellerId])
  @@index([brandId, model])
  @@index([price])
  @@index([year])
}

// One bullet in the Features section of a listing, e.g. SAFETY / "6 airbags". position keeps
// the order the admin wrote them in.
model CarFeature {
  id       Int             @id @default(autoincrement())
  carId    Int
  category FeatureCategory
  name     String          @db.VarChar(120)
  position Int

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId, category, position])
}

model CarImage {
  id         Int      @id @default(autoincrement())
  carId      Int
  url        String
  // Set for files this API stored (uploads); NULL for a photo that lives at an external URL.
  storageKey String?
  position   Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
}

model Favorite {
  id     Int @id @default(autoincrement())
  userId Int
  carId  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
}

// ---------------------------------------------------------------------------------------------
// Home Page CMS
//
// Single-instance sections live in HomePageContent, one row per section. The unique sectionType
// is what guarantees there is never a duplicate, and rows are created by the migration and only
// ever updated, never created or deleted through the API. Which of the text columns a section
// actually uses is defined in src/config/homeCms.js; the unused ones stay NULL.
//
// Repeatable content gets its own table each, ordered by displayOrder and hidden when
// isActive = false. displayOrder is deliberately not unique so items can be reordered without
// juggling temporary values. Extra CHECK constraints (see the home_page_cms migration) cover what
// Prisma cannot express.
// ---------------------------------------------------------------------------------------------

enum HomeSectionType {
  HERO
  FEATURED
  BRANDS
  WHY_CHOOSE_US
  HOW_IT_WORKS
  BUDGET
  JUST_LISTED
  TESTIMONIALS
  EXPLORE
}

model HomePageContent {
  id              Int             @id @default(autoincrement())
  sectionType     HomeSectionType @unique
  sectionTitle    String?         @db.VarChar(80)
  title           String          @db.VarChar(200)
  highlightedText String?         @db.VarChar(100)
  description     String?         @db.VarChar(600)
  buttonText      String?         @db.VarChar(40)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroStat {
  id           Int     @id @default(autoincrement())
  label        String  @db.VarChar(50)
  value        String  @db.VarChar(30)
  displayOrder Int
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}

// A brand tile on the home page. The brand itself is master data (Brand): a tile only points at
// one, so its name is never duplicated here and renaming a brand updates the tile. What belongs to
// the tile is its photo, position and visibility. A brand can be on the home page at most once,
// and deleting the master brand removes its tile.
// The car count shown on a tile is derived from the listings, not stored.
model HomeBrand {
  id           Int     @id @default(autoincrement())
  brandId      Int     @unique
  imageUrl     String  @db.VarChar(2048)
  displayOrder Int
  isActive     Boolean @default(true)

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model WhyChooseUsItem {
  id           Int     @id @default(autoincrement())
  title        String  @db.VarChar(100)
  description  String  @db.VarChar(400)
  icon         String  @db.VarChar(40)
  displayOrder Int
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}

// The step number shown on the site is the item's position, so it follows reordering.
model HowItWorksStep {
  id           Int     @id @default(autoincrement())
  title        String  @db.VarChar(100)
  description  String  @db.VarChar(400)
  icon         String  @db.VarChar(40)
  displayOrder Int
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}

// A price band in lakhs (1 lakh = 100,000). Either bound may be NULL for an open-ended band.
model BudgetItem {
  id           Int      @id @default(autoincrement())
  label        String   @db.VarChar(60)
  minPriceLakh Decimal? @db.Decimal(8, 2)
  maxPriceLakh Decimal? @db.Decimal(8, 2)
  displayOrder Int
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model Testimonial {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(100)
  location     String  @db.VarChar(100)
  car          String  @db.VarChar(100)
  rating       Int
  review       String  @db.VarChar(1000)
  avatarUrl    String  @db.VarChar(2048)
  displayOrder Int
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}

// ---------------------------------------------------------------------------------------------
// Site identity (logo + brand name), used everywhere the site's chrome renders (navbar, footer,
// page titles, admin sidebar) — not just the home page, so this is deliberately its own singleton
// rather than another Home Page CMS section.
//
// A fixed single row (id = 1), created by the site_settings migration and only ever updated.
// brandName is edited directly; logoUrl / logoStorageKey are only ever set by the logo upload
// endpoint (which also removes the previous file) and cleared by the remove-logo endpoint, never
// written directly. At least one of brandName / logoUrl must be set at all times — enforced here
// by the service before every write, and backstopped by a CHECK constraint (see the migration)
// for anything that bypasses it.
// ---------------------------------------------------------------------------------------------
model SiteSettings {
  id        Int     @id @default(1)
  brandName String? @db.VarChar(60)
  // Set together: the public URL shown on the site, and the storage key used to delete the file
  // when the logo is replaced or removed. logoStorageKey is never exposed by the API.
  logoUrl        String? @db.VarChar(2048)
  logoStorageKey String? @db.VarChar(255)

  updatedAt DateTime @updatedAt
}
